# Copy to .env (never commit .env). Only EXPO_PUBLIC_* values are bundled into the app.
# Production defaults are used when these are not set.
# EXPO_PUBLIC_API_URL=https://api.erp.mwm247.com/api
# EXPO_PUBLIC_WEB_URL=https://erp.mwm247.com

# Local dev against `npm run dev` in server/ and client/ (Android emulator maps localhost -> 10.0.2.2 automatically):
# EXPO_PUBLIC_API_URL=http://localhost:5000/api
# EXPO_PUBLIC_WEB_URL=http://localhost:5173
# APP_VARIANT=development
