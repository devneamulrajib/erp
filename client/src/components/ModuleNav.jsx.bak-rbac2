import { useState, useRef, useEffect, useCallback, useMemo } from 'react';
import { Menu } from 'lucide-react';
import { getNavForUser } from './navConfig';
import MenuNode from './MenuNode';
import SidebarNav from './workspace/SidebarNav';
import { USER_UPDATED_EVENT } from './SessionSync';

function readUser() {
  try {
    return JSON.parse(localStorage.getItem('user') || 'null');
  } catch {
    return null;
  }
}

export default function ModuleNav({ badgeCounts = {}, itemBadgeCounts = {} }) {
  const [resetKey, setResetKey] = useState(0);
  const [user, setUser] = useState(readUser);
  const [drawerOpen, setDrawerOpen] = useState(false);
  const wrapperRef = useRef(null);

  // Users with an explicit section list only get their sections (see getNavForUser).
  const modules = useMemo(() => getNavForUser(user), [user]);

  useEffect(() => {
    const refresh = () => setUser(readUser());
    window.addEventListener(USER_UPDATED_EVENT, refresh);
    return () => window.removeEventListener(USER_UPDATED_EVENT, refresh);
  }, []);

  const closeAll = useCallback(() => {
    setResetKey((key) => key + 1);
  }, []);

  useEffect(() => {
    const handleClickOutside = (event) => {
      if (
        wrapperRef.current &&
        !wrapperRef.current.contains(event.target)
      ) {
        closeAll();
      }
    };

    const handleEscape = (event) => {
      if (event.key === 'Escape') {
        closeAll();
        setDrawerOpen(false);
      }
    };

    document.addEventListener('mousedown', handleClickOutside);
    document.addEventListener('keydown', handleEscape);

    return () => {
      document.removeEventListener('mousedown', handleClickOutside);
      document.removeEventListener('keydown', handleEscape);
    };
  }, [closeAll]);

  return (
    <>
      {/* Desktop / tablet: floating island with dropdowns and mega-menus */}
      <nav
        ref={wrapperRef}
        role="menubar"
        className="
          relative
          z-[99999]
          hidden
          w-fit
          max-w-[calc(100vw-24px)]
          items-center
          overflow-visible
          rounded-[24px]
          border
          border-black/[0.08]
          bg-white/95
          px-1.5
          py-1.5
          shadow-[0_10px_30px_rgba(0,0,0,0.12)]
          backdrop-blur-xl
          md:flex
        "
      >
        <div
          key={resetKey}
          className="
            flex
            items-center
            gap-0.5
            overflow-visible
          "
        >
          {modules.map((mod) => (
            <MenuNode
              key={mod.key}
              item={mod}
              depth={0}
              onNavigate={closeAll}
              badgeCount={badgeCounts[mod.key]}
              itemBadgeCounts={itemBadgeCounts}
            />
          ))}
        </div>
      </nav>

      {/* Phones: one button that opens the grouped sidebar as a drawer */}
      <button
        type="button"
        onClick={() => setDrawerOpen(true)}
        className="mt-2 inline-flex items-center gap-2 rounded-2xl border border-black/[0.08] bg-white px-4 py-2 text-xs font-semibold text-slate-800 shadow-[0_10px_30px_rgba(0,0,0,0.10)] md:hidden"
      >
        <Menu size={15} />
        Menu
      </button>
      {drawerOpen && (
        <div className="fixed inset-0 z-[100000] md:hidden">
          <button
            type="button"
            aria-label="Close menu"
            className="absolute inset-0 bg-slate-950/50 backdrop-blur-[2px]"
            onClick={() => setDrawerOpen(false)}
          />
          <SidebarNav
            user={user}
            className="relative h-full shadow-2xl"
            onNavigate={() => setDrawerOpen(false)}
            onClose={() => setDrawerOpen(false)}
          />
        </div>
      )}
    </>
  );
}
