// client/src/components/MenuNode.jsx
import { useState, useRef, useEffect } from 'react';
import { useNavigate, useLocation } from 'react-router-dom';
import { ChevronDown, ChevronRight } from 'lucide-react';

function supportsHover() {
  if (typeof window === 'undefined' || !window.matchMedia) {
    return true;
  }
  return window.matchMedia('(hover: hover) and (pointer: fine)').matches;
}

// ---------------------------------------------------------------------------
// Mega-menu (used for long top-level menus such as Accounting and HRM).
// Same items as the normal dropdown, laid out in columns: loose items are
// grouped by their `group` label, every sub-menu becomes its own column, and
// deeper levels are shown as small headed lists inside that column.
// ---------------------------------------------------------------------------
function MegaLink({ item, onNavigate, itemBadgeCounts, nested = false }) {
  const navigate = useNavigate();
  const location = useLocation();
  const active = item.route && location.pathname === item.route;
  const Icon = item.icon;
  const count = sumItemCounts(item, itemBadgeCounts);
  return (
    <button
      type="button"
      role="menuitem"
      data-menu-item
      onClick={() => {
        if (item.route) navigate(item.route);
        onNavigate?.();
      }}
      className={`group flex w-full items-center gap-2 rounded-[10px] px-2.5 py-1.5 text-left text-[12.5px] transition-colors ${
        active
          ? 'bg-black font-semibold text-white'
          : count > 0
          ? 'bg-rose-50/70 font-semibold text-[#252525] hover:bg-rose-50'
          : 'text-[#303030] hover:bg-[#f3f3f3]'
      } ${nested ? 'pl-4' : ''}`}
    >
      {Icon ? (
        <Icon size={14} strokeWidth={1.8} className={active ? 'text-white' : 'text-slate-400 group-hover:text-slate-700'} />
      ) : (
        <span className={`size-1 shrink-0 rounded-full ${active ? 'bg-white' : 'bg-slate-300 group-hover:bg-slate-600'}`} />
      )}
      <span className="truncate">{item.label}</span>
      {count > 0 && (
        <span className="ml-auto flex h-[18px] min-w-[18px] items-center justify-center rounded-full bg-rose-500 px-1.5 text-[10px] font-bold text-white">
          {count > 9 ? '9+' : count}
        </span>
      )}
    </button>
  );
}

function MegaColumnItems({ items, onNavigate, itemBadgeCounts, depth = 0 }) {
  return items.map((child) =>
    child.children?.length ? (
      <div key={child.key} className="mt-1.5">
        <p className={`px-2.5 pb-0.5 pt-1 text-[10px] font-bold uppercase tracking-wider text-slate-400 ${depth ? 'pl-4' : ''}`}>
          {child.label}
        </p>
        <MegaColumnItems items={child.children} onNavigate={onNavigate} itemBadgeCounts={itemBadgeCounts} depth={depth + 1} />
      </div>
    ) : (
      <MegaLink key={child.key} item={child} onNavigate={onNavigate} itemBadgeCounts={itemBadgeCounts} nested={depth > 0} />
    )
  );
}

function MegaPanel({ item, onNavigate, itemBadgeCounts }) {
  const leaves = item.children.filter((c) => !c.children?.length);
  const branches = item.children.filter((c) => c.children?.length);
  const groups = [];
  leaves.forEach((leaf) => {
    const name = leaf.group || 'General';
    let g = groups.find((x) => x.name === name);
    if (!g) {
      g = { name, items: [] };
      groups.push(g);
    }
    g.items.push(leaf);
  });
  const columns = [
    ...groups.map((g) => ({ key: `group-${g.name}`, title: g.name, items: g.items })),
    ...branches.map((b) => ({ key: b.key, title: b.label, icon: b.icon, highlight: b.highlight, items: b.children })),
  ];
  return (
    <div className="grid max-h-[min(70vh,620px)] grid-cols-2 gap-x-3 gap-y-4 overflow-y-auto p-2 lg:grid-cols-3 xl:grid-cols-4">
      {columns.map((col) => {
        const ColIcon = col.icon;
        return (
          <div
            key={col.key}
            className={`min-w-0 rounded-[14px] p-1.5 ${col.highlight ? 'border border-blue-200/80 bg-gradient-to-b from-blue-50/80 to-white' : ''}`}
          >
            <p className="flex items-center gap-1.5 px-2.5 pb-1.5 text-[11px] font-bold uppercase tracking-wider text-slate-500">
              {ColIcon && <ColIcon size={12} className={col.highlight ? 'text-blue-600' : ''} />}
              <span className="truncate">{col.title}</span>
              {col.highlight && (
                <span className="rounded-md bg-blue-600 px-1.5 py-0.5 text-[9px] font-black uppercase tracking-wider text-white">HUB</span>
              )}
            </p>
            <div className="flex flex-col gap-0.5">
              <MegaColumnItems items={col.items} onNavigate={onNavigate} itemBadgeCounts={itemBadgeCounts} />
            </div>
          </div>
        );
      })}
    </div>
  );
}

// Own count + counts of every descendant, so a parent like "Adjustment"
// lights up when something inside it has a new item.
function sumItemCounts(item, counts) {
  let total = counts[item.key] || 0;
  if (Array.isArray(item.children)) {
    item.children.forEach((child) => {
      total += sumItemCounts(child, counts);
    });
  }
  return total;
}

export default function MenuNode({
  item,
  depth = 0,
  onNavigate,
  badgeCount = 0,
  itemBadgeCounts = {},
}) {
  const navigate = useNavigate();
  const location = useLocation();

  const [isOpen, setIsOpen] = useState(false);
  const [flipLeft, setFlipLeft] = useState(false);

  const nodeRef = useRef(null);
  const panelRef = useRef(null);
  const closeTimer = useRef(null);

  const hoverCapable = useRef(supportsHover());

  const hasChildren = Array.isArray(item.children) && item.children.length > 0;
  const isTopLevel = depth === 0;
  const isMega = isTopLevel && hasChildren && Boolean(item.ui?.mega) && item.children.length > 3;
  const Icon = item.icon;
  const isActive = item.route && location.pathname === item.route;
  const isHighlight = Boolean(item.highlight || item.key === 'office-budget');

  // Top-level uses the module count; submenu items use their own/descendant count.
  const count = isTopLevel ? Number(badgeCount) || 0 : sumItemCounts(item, itemBadgeCounts);

  useEffect(() => {
    return () => {
      clearTimeout(closeTimer.current);
    };
  }, []);

  // Detect edge collision and flip dropdown to the left if overflowing viewport
  useEffect(() => {
    if (!isOpen || !panelRef.current) return;

    const checkPosition = () => {
      if (!panelRef.current) return;
      const rect = panelRef.current.getBoundingClientRect();
      setFlipLeft(rect.right > window.innerWidth - 16);
    };

    requestAnimationFrame(checkPosition);
    window.addEventListener('resize', checkPosition);
    window.addEventListener('scroll', checkPosition, true);

    return () => {
      window.removeEventListener('resize', checkPosition);
      window.removeEventListener('scroll', checkPosition, true);
    };
  }, [isOpen, isTopLevel]);

  const openNow = () => {
    clearTimeout(closeTimer.current);
    setIsOpen(true);
  };

  const scheduleClose = () => {
    clearTimeout(closeTimer.current);
    closeTimer.current = setTimeout(() => {
      setIsOpen(false);
    }, 180);
  };

  const handleActivate = () => {
    if (hasChildren) {
      setIsOpen((current) => !current);
      return;
    }
    if (item.route) {
      navigate(item.route);
    }
    onNavigate?.();
  };

  const focusSibling = (direction) => {
    const parent = nodeRef.current?.parentElement;
    if (!parent) return;

    const siblings = Array.from(parent.querySelectorAll(':scope > div > [data-menu-item]'));
    const currentIndex = siblings.indexOf(nodeRef.current);
    if (currentIndex === -1) return;

    const nextIndex =
      direction === 1
        ? (currentIndex + 1) % siblings.length
        : (currentIndex - 1 + siblings.length) % siblings.length;

    siblings[nextIndex]?.focus();
  };

  const handleKeyDown = (event) => {
    switch (event.key) {
      case 'Enter':
      case ' ':
        event.preventDefault();
        handleActivate();
        break;
      case 'ArrowRight':
        if (hasChildren) {
          event.preventDefault();
          openNow();
          requestAnimationFrame(() => {
            panelRef.current?.querySelector('[data-menu-item]')?.focus();
          });
        }
        break;
      case 'ArrowLeft':
        if (depth > 0) {
          event.preventDefault();
          setIsOpen(false);
          nodeRef.current?.focus();
        }
        break;
      case 'Escape':
        event.preventDefault();
        setIsOpen(false);
        nodeRef.current?.focus();
        break;
      case 'ArrowDown':
        event.preventDefault();
        focusSibling(1);
        break;
      case 'ArrowUp':
        event.preventDefault();
        focusSibling(-1);
        break;
      default:
        break;
    }
  };

  const hoverHandlers =
    hasChildren && hoverCapable.current
      ? {
          onMouseEnter: openNow,
          onMouseLeave: scheduleClose,
        }
      : {};

  return (
    // Mega panels are positioned against the whole island (nav is `relative`).
    <div className={`${isMega ? 'static' : 'relative'} overflow-visible`} {...hoverHandlers}>
      {/* =====================================================
          MENU TRIGGER BUTTON
      ====================================================== */}
      <button
        ref={nodeRef}
        data-menu-item
        type="button"
        role="menuitem"
        aria-haspopup={hasChildren ? 'menu' : undefined}
        aria-expanded={hasChildren ? isOpen : undefined}
        onClick={handleActivate}
        onKeyDown={handleKeyDown}
        className={`
          group
          relative
          flex
          items-center
          whitespace-nowrap
          transition-all
          duration-200
          ease-out

          ${
            isTopLevel
              ? 'h-[38px] gap-2 rounded-[18px] px-4 text-[12px] font-medium'
              : 'w-full gap-2.5 rounded-[12px] px-3 py-2 text-left text-[13px]'
          }

          ${
            isTopLevel
              ? isOpen || isActive
                ? 'bg-black text-white shadow-[0_4px_12px_rgba(0,0,0,0.18)]'
                : 'bg-transparent text-[#202020] hover:bg-[#f2f2f2]'
              : isActive
              ? 'bg-black text-white font-semibold'
              : isHighlight
              ? `
                  bg-gradient-to-r from-blue-50/90 via-indigo-50/70 to-blue-50/40
                  text-blue-900 font-bold
                  border border-blue-200/80
                  shadow-[0_2px_8px_rgba(37,99,235,0.06)]
                  hover:from-blue-100 hover:to-indigo-100
                  hover:border-blue-300
                `
              : count > 0
              ? 'bg-rose-50/70 text-[#252525] font-semibold hover:bg-rose-50'
              : 'bg-transparent text-[#252525] font-medium hover:bg-[#f3f3f3]'
          }
        `}
      >
        {/* ICON */}
        {Icon && (
          <Icon
            size={15}
            strokeWidth={isHighlight && !isActive ? 2.2 : 1.8}
            className={`
              shrink-0
              transition-transform
              duration-200

              ${isHighlight && !isActive ? 'text-blue-600' : ''}
              ${isOpen ? 'scale-105' : 'group-hover:scale-105'}
            `}
          />
        )}

        {/* LABEL */}
        <span className="truncate">{item.label}</span>

        {/* NEW-ITEM COUNT BADGE */}
        {count > 0 && (
          <span
            title={`${count} new`}
            className={`
              flex
              shrink-0
              items-center
              justify-center
              rounded-full
              bg-rose-500
              font-bold
              leading-none
              text-white
              ${
                isTopLevel
                  ? 'h-[18px] min-w-[18px] px-1 text-[10px] ring-2 ring-white'
                  : 'h-[18px] min-w-[18px] px-1.5 text-[10px]'
              }
            `}
          >
            <span className="relative flex items-center justify-center">
              {count > 9 ? '9+' : count}
            </span>
          </span>
        )}

        {/* HIGHLIGHT PILL BADGE FOR SUBMENU */}
        {!isTopLevel && isHighlight && !isActive && (
          <span className="ml-1 rounded-md bg-blue-600 px-1.5 py-0.5 text-[9px] font-black uppercase tracking-wider text-white shadow-xs">
            HUB
          </span>
        )}

        {/* CHEVRON INDICATOR */}
        {hasChildren && (
          <span className="ml-auto flex shrink-0 items-center pl-1.5">
            {isTopLevel ? (
              <ChevronDown
                size={13}
                strokeWidth={1.8}
                className={`
                  transition-transform
                  duration-200
                  ${isOpen ? 'rotate-180' : ''}
                `}
              />
            ) : (
              <ChevronRight
                size={14}
                strokeWidth={isHighlight ? 2.2 : 1.8}
                className={`
                  ${isHighlight && !isActive ? 'text-blue-600' : 'text-current opacity-50'}
                `}
              />
            )}
          </span>
        )}
      </button>

      {/* =====================================================
          DROPDOWN POPUP PANEL
      ====================================================== */}
      {hasChildren && (
        <div
          ref={panelRef}
          role="menu"
          aria-hidden={!isOpen}
          onMouseEnter={hoverCapable.current ? openNow : undefined}
          onMouseLeave={hoverCapable.current ? scheduleClose : undefined}
          className={`
            absolute
            z-[999999]
            overflow-visible

            rounded-[16px]
            border
            border-black/[0.08]
            bg-white
            p-1.5

            shadow-[0_18px_45px_rgba(0,0,0,0.16)]

            transition-all
            duration-150
            ease-out

            ${
              isOpen
                ? 'visible pointer-events-auto translate-y-0 scale-100 opacity-100'
                : 'invisible pointer-events-none translate-y-1 scale-[0.98] opacity-0'
            }

            ${
              isMega
                ? 'left-1/2 top-full mt-2 w-[min(960px,calc(100vw-24px))] -translate-x-1/2'
                : isTopLevel
                ? `top-full mt-2 w-[240px] ${flipLeft ? 'right-0' : 'left-0'}`
                : `top-0 w-[230px] ${flipLeft ? 'right-full mr-2' : 'left-full ml-2'}`
            }
          `}
        >
          {isMega && (
            <div className="flex items-center justify-between gap-3 border-b border-black/[0.06] px-3.5 pb-2.5 pt-1.5">
              <div className="flex items-center gap-2">
                {Icon && <Icon size={15} strokeWidth={1.8} className="text-slate-500" />}
                <span className="text-[13px] font-bold text-slate-900">{item.label}</span>
              </div>
              <span className="text-[11px] text-slate-400">Every {item.label} page, grouped</span>
            </div>
          )}
          {isMega && <MegaPanel item={item} onNavigate={onNavigate} itemBadgeCounts={itemBadgeCounts} />}

          {/* Top-level subtle pointer arrow */}
          {isTopLevel && !isMega && (
            <div
              className={`
                absolute
                -top-1.5
                h-3
                w-3
                rotate-45
                border-l
                border-t
                border-black/[0.08]
                bg-white
                ${flipLeft ? 'right-7' : 'left-7'}
              `}
            />
          )}

          {/* Child menu tree */}
          {!isMega && (
          <div className="relative flex flex-col gap-0.5">
            {item.children.map((child) => (
              <MenuNode
                key={child.key}
                item={child}
                depth={depth + 1}
                onNavigate={onNavigate}
                itemBadgeCounts={itemBadgeCounts}
              />
            ))}
          </div>
          )}
        </div>
      )}
    </div>
  );
}