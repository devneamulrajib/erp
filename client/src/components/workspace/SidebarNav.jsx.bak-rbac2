// client/src/components/workspace/SidebarNav.jsx
// Dark navy grouped sidebar (Trikon demo style). Used as the fixed sidebar of
// the personal workspace and as the mobile menu drawer of the floating island.
// Shows exactly the menu returned by getNavForUser(), so every dropdown item
// the user may open is here too, grouped by section and collapsible.
import { useEffect, useMemo, useState } from 'react';
import { useLocation, useNavigate } from 'react-router-dom';
import { ChevronDown, ChevronRight, X } from 'lucide-react';
import companyLogo from '../../assets/trikon-logo.png';
import { getNavForUser, menuContainsRoute } from '../navConfig';

function Leaf({ item, depth, onNavigate, pathname }) {
  const navigate = useNavigate();
  const active = item.route && pathname === item.route;
  const Icon = item.icon;
  return (
    <button
      type="button"
      onClick={() => {
        if (item.route) navigate(item.route);
        onNavigate?.();
      }}
      className={`group flex w-full items-center gap-2.5 rounded-xl py-2 pr-3 text-left text-[13px] transition-colors ${
        active
          ? 'bg-yellow-400 font-semibold text-slate-900 shadow-[0_6px_18px_rgba(250,204,21,0.25)]'
          : 'text-slate-300 hover:bg-white/[0.06] hover:text-white'
      }`}
      style={{ paddingLeft: 12 + depth * 12 }}
    >
      {Icon ? (
        <Icon size={15} className={active ? 'text-slate-900' : 'text-slate-400 group-hover:text-yellow-300'} />
      ) : (
        <span className={`size-1.5 shrink-0 rounded-full ${active ? 'bg-slate-900' : 'bg-slate-600 group-hover:bg-yellow-300'}`} />
      )}
      <span className="truncate">{item.label}</span>
      {item.highlight && !active && (
        <span className="ml-auto rounded-md bg-yellow-400/90 px-1.5 py-0.5 text-[9px] font-black uppercase tracking-wider text-slate-900">
          HUB
        </span>
      )}
    </button>
  );
}

function Branch({ item, depth, onNavigate, pathname }) {
  const containsActive = menuContainsRoute(item, pathname);
  const [open, setOpen] = useState(containsActive);
  useEffect(() => {
    if (containsActive) setOpen(true);
  }, [containsActive]);
  const Icon = item.icon;
  return (
    <div>
      <button
        type="button"
        onClick={() => setOpen((v) => !v)}
        aria-expanded={open}
        className={`flex w-full items-center gap-2.5 rounded-xl py-2 pr-3 text-left text-[13px] transition-colors ${
          containsActive ? 'text-white' : 'text-slate-300 hover:bg-white/[0.06] hover:text-white'
        }`}
        style={{ paddingLeft: 12 + depth * 12 }}
      >
        {Icon ? <Icon size={15} className="text-slate-400" /> : <span className="size-1.5 shrink-0 rounded-full bg-slate-600" />}
        <span className="truncate">{item.label}</span>
        {item.highlight && (
          <span className="rounded-md bg-yellow-400/90 px-1.5 py-0.5 text-[9px] font-black uppercase tracking-wider text-slate-900">
            HUB
          </span>
        )}
        <ChevronRight size={14} className={`ml-auto shrink-0 text-slate-500 transition-transform ${open ? 'rotate-90' : ''}`} />
      </button>
      {open && (
        <div className="mt-0.5 space-y-0.5 border-l border-white/[0.06]" style={{ marginLeft: 18 + depth * 12 }}>
          {item.children.map((child) => (
            <Node key={child.key} item={child} depth={0} onNavigate={onNavigate} pathname={pathname} />
          ))}
        </div>
      )}
    </div>
  );
}

function Node(props) {
  return props.item.children?.length ? <Branch {...props} /> : <Leaf {...props} />;
}

function Section({ module, onNavigate, pathname }) {
  const containsActive = menuContainsRoute(module, pathname);
  const [open, setOpen] = useState(true);
  const Icon = module.icon;

  if (!module.children?.length) {
    return (
      <div className="px-3">
        <Leaf item={module} depth={0} onNavigate={onNavigate} pathname={pathname} />
      </div>
    );
  }
  return (
    <div className="px-3">
      <button
        type="button"
        onClick={() => setOpen((v) => !v)}
        className="flex w-full items-center gap-2 px-3 pb-1.5 pt-4 text-[10.5px] font-bold uppercase tracking-[0.16em] text-slate-500 hover:text-slate-300"
      >
        {Icon && <Icon size={12} className={containsActive ? 'text-yellow-400' : ''} />}
        <span className={containsActive ? 'text-slate-200' : ''}>{module.label}</span>
        <ChevronDown size={12} className={`ml-auto transition-transform ${open ? '' : '-rotate-90'}`} />
      </button>
      {open && (
        <div className="space-y-0.5">
          {module.children.map((child) => (
            <Node key={child.key} item={child} depth={0} onNavigate={onNavigate} pathname={pathname} />
          ))}
        </div>
      )}
    </div>
  );
}

export default function SidebarNav({ user, onNavigate, onClose, className = '' }) {
  const { pathname } = useLocation();
  const navigate = useNavigate();
  const modules = useMemo(() => getNavForUser(user), [user]);
  const roleLabel = user?.role ? String(user.role) : 'user';

  return (
    <aside className={`flex h-full w-72 flex-col bg-[#0b1530] text-white ${className}`}>
      <div className="flex items-center gap-3 border-b border-white/[0.06] px-5 py-5">
        <button
          type="button"
          onClick={() => {
            navigate('/');
            onNavigate?.();
          }}
          className="flex min-w-0 items-center gap-3 text-left"
        >
          <span className="flex size-10 shrink-0 items-center justify-center rounded-xl bg-white p-1.5">
            <img src={companyLogo} alt="Trikon" className="h-full w-full object-contain" />
          </span>
          <span className="min-w-0">
            <span className="block truncate text-[13px] font-extrabold tracking-wide">TRIKON HOLDINGS</span>
            <span className="block text-[10px] font-bold uppercase tracking-[0.25em] text-yellow-400">ERP</span>
          </span>
        </button>
        {onClose && (
          <button
            type="button"
            aria-label="Close menu"
            onClick={onClose}
            className="ml-auto flex size-8 items-center justify-center rounded-lg text-slate-400 hover:bg-white/10 hover:text-white"
          >
            <X size={16} />
          </button>
        )}
      </div>

      <nav className="flex-1 overflow-y-auto pb-6 [scrollbar-width:thin]">
        {modules.map((m) => (
          <Section key={m.key} module={m} onNavigate={onNavigate} pathname={pathname} />
        ))}
      </nav>

      <div className="border-t border-white/[0.06] px-5 py-4">
        <p className="truncate text-xs font-semibold text-slate-200">{user?.name || 'ERP User'}</p>
        <p className="text-[10px] font-semibold uppercase tracking-wider text-slate-500">{roleLabel}</p>
      </div>
    </aside>
  );
}
